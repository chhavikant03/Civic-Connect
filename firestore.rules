rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role verification: Prioritize cryptographically signed Custom Auth Claims
    // with graceful fallback for local emulators and legacy un-migrated accounts.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Self-registration is strictly role: 'citizen'. Client cannot elevate to admin.
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                    request.resource.data.role == 'citizen';
      // Prevent role modification during user profile updates.
      allow update: if isAuthenticated() && request.auth.uid == userId &&
                    request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /offlineComplaintReceipts/{localId} {
        function matchesUploadedComplaint() {
          let issuePath = /databases/$(database)/documents/issues/$(localId);
          let uploaded = getAfter(issuePath);
          return uploaded.data.reportedBy == userId &&
                 (!exists(issuePath) || uploaded.data == get(issuePath).data);
        }

        allow get: if isAuthenticated() && request.auth.uid == userId;
        // A legacy upload can be recorded without rewriting its saved complaint.
        allow create: if isAuthenticated() && request.auth.uid == userId &&
                      request.resource.data.keys().hasOnly(['createdAt']) &&
                      request.resource.data.createdAt == request.time &&
                      matchesUploadedComplaint();
        allow list, update, delete: if false;
      }
    }

    match /issues/{issueId} {
      function isResolutionFeedback() {
        let feedback = request.resource.data.get('feedback', {});
        let allowedTags = ['Quick response', 'Courteous staff', 'Clean finish'];
        let attachment = feedback.get('attachment', null);
        return resource.data.status == 'Resolved' &&
               resource.data.get('feedback', null) == null &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['feedback', 'updatedAt']) &&
               feedback.keys().hasOnly(['rating', 'tags', 'comment', 'attachment', 'submittedAt']) &&
               feedback.rating is int && feedback.rating >= 1 && feedback.rating <= 5 &&
               feedback.tags is list && feedback.tags.hasOnly(allowedTags) &&
               feedback.tags.size() == feedback.tags.toSet().size() &&
               feedback.comment is string && feedback.comment.size() <= 1000 &&
               feedback.submittedAt == request.time && request.resource.data.updatedAt == request.time &&
               (attachment == null ||
                 (attachment.keys().hasOnly(['kind', 'path']) &&
                  attachment.kind in ['photo', 'voice'] &&
                  attachment.path is string &&
                  attachment.path.matches('resolution-feedback/' + request.auth.uid + '/' + issueId + '/[0-9a-f-]{36}')));
      }

      function isCitizenAppeal() {
        let resolvedAt = resource.data.get('resolvedAt', null);
        let reason = request.resource.data.get('reopenReason', null);
        return resource.data.status == 'Resolved' &&
               request.resource.data.status == 'Reopened' &&
               resolvedAt is timestamp &&
               resolvedAt <= request.time &&
               request.time <= resolvedAt + duration.value(7, 'd') &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'reopenReason', 'reopenedAt', 'updatedAt']) &&
               reason is string &&
               // Match the whitespace-only inputs rejected by the client's trim().
               !reason.matches('[\\s\\p{Z}\\x0B\\x{FEFF}]*') &&
               request.resource.data.get('reopenedAt', null) == request.time &&
               request.resource.data.get('updatedAt', null) == request.time;
      }

      function isCitizenUpvote() {
        let diff = request.resource.data.diff(resource.data);
        let currentCount = resource.data.get('upvotesCount', 0);
        let newCount = request.resource.data.get('upvotesCount', 0);
        let prevUpvotedBy = resource.data.get('upvotedBy', []);
        let nextUpvotedBy = request.resource.data.get('upvotedBy', []);

        return diff.affectedKeys().hasOnly(['upvotedBy', 'upvotesCount', 'updatedAt']) &&
               request.resource.data.reportedBy == resource.data.reportedBy &&
               request.resource.data.status == resource.data.status &&
               newCount is int && newCount >= 0 &&
               (
                 // Adding an upvote:
                 (newCount == currentCount + 1 &&
                  !(request.auth.uid in prevUpvotedBy) &&
                  request.auth.uid in nextUpvotedBy) ||
                 // Removing an upvote:
                 (newCount == (currentCount > 0 ? currentCount - 1 : 0) &&
                  request.auth.uid in prevUpvotedBy &&
                  !(request.auth.uid in nextUpvotedBy))
               );
      }

      function isCitizenEndorsement() {
        let diff = request.resource.data.diff(resource.data);
        let currentCount = resource.data.get('endorsementCount', 0);
        let newCount = request.resource.data.get('endorsementCount', 0);
        let prevEndorsedBy = resource.data.get('endorsedBy', []);
        let nextEndorsedBy = request.resource.data.get('endorsedBy', []);

        return diff.affectedKeys().hasOnly(['endorsedBy', 'endorsementCount', 'updatedAt']) &&
               request.resource.data.reportedBy == resource.data.reportedBy &&
               request.resource.data.status == resource.data.status &&
               newCount is int && newCount >= 0 &&
               newCount == currentCount + 1 &&
               !(request.auth.uid in prevEndorsedBy) &&
               request.auth.uid in nextEndorsedBy;
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.reportedBy == request.auth.uid &&
                    request.resource.data.status == 'Pending' &&
                    !request.resource.data.keys().hasAny(['feedback']);
      allow update: if (isAuthenticated() && (
                        (resource.data.reportedBy == request.auth.uid &&
                          ((resource.data.status == 'Pending' &&
                            request.resource.data.status == 'Pending' &&
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['feedback'])) ||
                           isCitizenAppeal() || isResolutionFeedback())) ||
                        isCitizenUpvote() ||
                        isCitizenEndorsement()
                      )) || isAdmin();
      allow delete: if isAuthenticated() && resource.data.reportedBy == request.auth.uid &&
                    resource.data.status == 'Pending';

      // Community discussion comments sub-collection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                      request.resource.data.authorId == request.auth.uid &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() > 0 &&
                      request.resource.data.text.size() <= 1000 &&
                      request.resource.data.createdAt == request.time;
        allow update: if isAuthenticated() &&
                      resource.data.authorId == request.auth.uid &&
                      request.resource.data.authorId == resource.data.authorId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']) &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() > 0 &&
                      request.resource.data.text.size() <= 1000;
        allow delete: if isAuthenticated() &&
                      (resource.data.authorId == request.auth.uid || isAdmin());
      }

      // Immutable event audit trail sub-collection
      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // Platform-wide configuration. Canned resolution templates are readable
    // by any signed-in user (officers load them in the complaint workflow);
    // only administrators may change settings.
    match /settings/{settingId} {
      allow read: if isAdmin() ||
                    (isAuthenticated() && settingId == 'resolutionTemplates');
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                  (resource.data.recipientUid == request.auth.uid ||
                   (resource.data.recipientRole == 'admin' && isAdmin()));
      allow update: if isAuthenticated() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated();
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if isAuthenticated();
      // Counter must be a positive integer and monotonically non-decreasing to prevent corruption & DoS
      allow write: if isAuthenticated() &&
                   request.resource.data.lastNumber is int &&
                   request.resource.data.lastNumber > 0 &&
                   (!exists(/databases/$(database)/documents/counters/$(counterId)) ||
                    request.resource.data.lastNumber >= resource.data.lastNumber);
    }

    match /leaderboard/{userId} {
      function isValidLeaderboardEntry() {
        let data = request.resource.data;
        let allowedKeys = [
          'uid', 'name', 'displayName', 'monthlyScore',
          'allTimeScore', 'badgesCount', 'reportsCount', 'level', 'updatedAt'
        ];
        return data.keys().hasOnly(allowedKeys) &&
               data.uid == userId &&
               data.get('name', '') is string &&
               data.get('name', '').size() <= 100 &&
               data.get('displayName', '') is string &&
               data.get('displayName', '').size() <= 100 &&
               data.get('monthlyScore', 0) is number &&
               data.get('monthlyScore', 0) >= 0 &&
               data.get('allTimeScore', 0) is number &&
               data.get('allTimeScore', 0) >= 0 &&
               data.get('badgesCount', 0) is number &&
               data.get('badgesCount', 0) >= 0 &&
               data.get('reportsCount', 0) is number &&
               data.get('reportsCount', 0) >= 0 &&
               data.get('level', 1) is number &&
               data.get('level', 1) >= 1 &&
               data.get('updatedAt', null) == request.time;
      }

      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                            (request.auth.uid == userId || isAdmin()) &&
                            isValidLeaderboardEntry();
      allow delete: if isAdmin();
    }
  }
}

