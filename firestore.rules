rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role verification: Prioritize cryptographically signed Custom Auth Claims
    // with graceful fallback for local emulators and legacy un-migrated accounts.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /users/{userId} {
      // Allow authenticated users to view profiles (for civic leaderboards, report attributions, and public civic engagement) or admins
      allow read: if isAuthenticated();
      // Self-registration is strictly role: 'citizen'. Client cannot elevate to admin.
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                    request.resource.data.role == 'citizen';
      // Prevent role modification during user profile updates.
      allow update: if isAuthenticated() && request.auth.uid == userId &&
                    request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /offlineComplaintReceipts/{localId} {
        function matchesUploadedComplaint() {
          let issuePath = /databases/$(database)/documents/issues/$(localId);
          let uploaded = getAfter(issuePath);
          return uploaded.data.reportedBy == userId &&
                 (!exists(issuePath) || uploaded.data == get(issuePath).data);
        }

        allow get: if isAuthenticated() && request.auth.uid == userId;
        // A legacy upload can be recorded without rewriting its saved complaint.
        allow create: if isAuthenticated() && request.auth.uid == userId &&
                      request.resource.data.keys().hasOnly(['createdAt']) &&
                      request.resource.data.createdAt == request.time &&
                      matchesUploadedComplaint();
        allow list, update, delete: if false;
      }
    }

    match /issues/{issueId} {
      function isCitizenAppeal() {
        let resolvedAt = resource.data.get('resolvedAt', null);
        let reason = request.resource.data.get('reopenReason', null);
        return resource.data.status == 'Resolved' &&
               request.resource.data.status == 'Reopened' &&
               resolvedAt is timestamp &&
               resolvedAt <= request.time &&
               request.time <= resolvedAt + duration.value(7, 'd') &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'reopenReason', 'reopenedAt', 'updatedAt']) &&
               reason is string &&
               // Match the whitespace-only inputs rejected by the client's trim().
               !reason.matches('[\\s\\p{Z}\\x0B\\x{FEFF}]*') &&
               request.resource.data.get('reopenedAt', null) == request.time &&
               request.resource.data.get('updatedAt', null) == request.time;
      }

      function isEndorsementOrUpvote() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['endorsedBy', 'endorsementCount', 'upvotedBy', 'upvotesCount', 'updatedAt']) &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.reportedBy == resource.data.reportedBy;
      }

      // Public civic complaints must be readable by authenticated citizens
      // (required for duplicate detection, community feed, citizen endorsement, merged ticket tracking, and map)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.reportedBy == request.auth.uid &&
                    request.resource.data.status == 'Pending';
      allow update: if (isAuthenticated() && (
        (resource.data.reportedBy == request.auth.uid &&
          ((resource.data.status == 'Pending' &&
            request.resource.data.status == 'Pending') || isCitizenAppeal())) ||
        isEndorsementOrUpvote()
      )) || isAdmin();
      allow delete: if isAuthenticated() && resource.data.reportedBy == request.auth.uid &&
                    resource.data.status == 'Pending';

      // Discussion comments sub-collection for community feed
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // Immutable event audit trail sub-collection
      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                  (resource.data.recipientUid == request.auth.uid ||
                   (resource.data.recipientRole == 'admin' && isAdmin()));
      allow update: if isAuthenticated() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated();
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if isAuthenticated();
      // Enforce positive integer and monotonic progression to prevent counter corruption DoS
      allow write: if isAuthenticated() &&
                   request.resource.data.lastNumber is int &&
                   request.resource.data.lastNumber > 0 &&
                   (!exists(/databases/$(database)/documents/counters/$(counterId)) ||
                    request.resource.data.lastNumber >= resource.data.lastNumber);
    }
  }
}

