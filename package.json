    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slot": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "framer-motion": "^14.9.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
